# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/jobs
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/jobs
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<replace_with_your_clerk_publishable_key>
CLERK_SECRET_KEY=sk_test_<replace_with_your_clerk_secret_key>

# Database (Neon). The jobs table is filled by scripts/ingest-jobs.ts — see
# knowledge/ingestion.md. The same value must exist as the DATABASE_URL
# secret in GitHub for the scheduled ingest workflow.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Upstash Redis — saved jobs and the short-lived per-user ranked feed cache.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=<replace_with_your_upstash_token>
